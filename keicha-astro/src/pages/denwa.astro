    <Fragment slot="scripts">
        <script is:inline>
            // Intro loader
            const MIN_LOADING_TIME = 1800;
            const startTime = Date.now();
            window.addEventListener("load", function () {
                const elapsedTime = Date.now() - startTime;
                const remainingTime = Math.max(
                    0,
                    MIN_LOADING_TIME - elapsedTime
                );
                setTimeout(() => {
                    const loader = document.getElementById("intro-loader");
                    const mainWrapper = document.getElementById("main-wrapper");
                    if (loader && mainWrapper) {
                        loader.classList.add("hidden-fade");
                        mainWrapper.classList.add("visible");
                        setTimeout(() => {
                            loader.style.display = "none";
                        }, 800);
                    }
                }, remainingTime);
            });
            window.KEICHA_BASEURL = "";
        </script>

        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                // Lightbox
                const lightbox = document.getElementById("lightbox");
                const lightboxImg = document.getElementById("lightbox-img");
                const lightboxClose = document.querySelector(".lightbox-close");
                const lightboxTriggers =
                    document.querySelectorAll(".lightbox-trigger");
                if (
                    lightbox &&
                    lightboxImg &&
                    lightboxClose &&
                    lightboxTriggers.length > 0
                ) {
                    const openLightbox = (e) => {
                        const src = e.target.src;
                        if (src) {
                            lightboxImg.src = src;
                            lightbox.classList.add("show", "opacity-100");
                        }
                    };
                    const closeLightbox = () => {
                        lightbox.classList.remove("show", "opacity-100");
                        setTimeout(() => {
                            lightboxImg.src = "";
                        }, 300);
                    };
                    lightboxTriggers.forEach((t) =>
                        t.addEventListener("click", openLightbox)
                    );
                    lightbox.addEventListener("click", (e) => {
                        if (e.target === lightbox || e.target === lightboxClose)
                            closeLightbox();
                    });
                    document.addEventListener("keydown", (e) => {
                        if (
                            e.key === "Escape" &&
                            lightbox.classList.contains("show")
                        )
                            closeLightbox();
                    });
                }

                // TOC
                const sections = document.querySelectorAll(
                    'section[id^="section-"]'
                );
                const navLinks = document.querySelectorAll(".nav-link");
                const tocNav = document.getElementById("toc-nav");
                if (tocNav && sections.length > 0 && navLinks.length > 0) {
                    const observer = new IntersectionObserver(
                        (entries) => {
                            let visible = [];
                            entries.forEach((e) => {
                                if (e.isIntersecting) visible.push(e.target);
                            });
                            if (visible.length > 0) {
                                const top = visible.reduce((p, c) =>
                                    p.getBoundingClientRect().top <
                                    c.getBoundingClientRect().top
                                        ? p
                                        : c
                                );
                                const id = top.getAttribute("id");
                                const link = tocNav.querySelector(
                                    `a[href="#${id}"]`
                                );
                                navLinks.forEach((l) =>
                                    l.classList.remove("active")
                                );
                                if (link) link.classList.add("active");
                            }
                        },
                        {
                            root: null,
                            rootMargin: "-80px 0px -40% 0px",
                            threshold: 0,
                        }
                    );
                    sections.forEach((s) => observer.observe(s));
                    tocNav.addEventListener("click", (e) => {
                        if (e.target.tagName === "A") {
                            e.preventDefault();
                            const el = document.querySelector(
                                e.target.getAttribute("href")
                            );
                            if (el) {
                                const pos =
                                    el.getBoundingClientRect().top +
                                    window.pageYOffset -
                                    90;
                                window.scrollTo({
                                    top: pos,
                                    behavior: "smooth",
                                });
                            }
                        }
                    });
                }

                // Slider
                const sliderWrapper = document.getElementById("slider-wrapper");
                if (sliderWrapper) {
                    const slides = document.querySelectorAll(".slider-slide");
                    const prevBtn = document.getElementById("slider-prev");
                    const nextBtn = document.getElementById("slider-next");
                    const dots = document.querySelectorAll(".slider-dot");
                    let current = 0;
                    const count = slides.length;
                    const goTo = (i) => {
                        if (count === 0) return;
                        if (i < 0) i = count - 1;
                        else if (i >= count) i = 0;
                        sliderWrapper.style.transform = `translateX(-${
                            i * 100
                        }%)`;
                        current = i;
                        updateDots();
                    };
                    const updateDots = () => {
                        dots.forEach((d, i) => {
                            if (i === current) {
                                d.classList.add("active", "bg-brandGreen");
                                d.classList.remove("bg-white", "bg-opacity-50");
                            } else {
                                d.classList.remove("active", "bg-brandGreen");
                                d.classList.add("bg-white", "bg-opacity-50");
                            }
                        });
                    };
                    if (prevBtn)
                        prevBtn.addEventListener("click", () =>
                            goTo(current - 1)
                        );
                    if (nextBtn)
                        nextBtn.addEventListener("click", () =>
                            goTo(current + 1)
                        );
                    dots.forEach((d, i) =>
                        d.addEventListener("click", () => goTo(i))
                    );
                    goTo(0);
                }

                // Accordion
                const accordionItems =
                    document.querySelectorAll(".accordion-item");
                if (accordionItems.length > 0) {
                    accordionItems.forEach((item) => {
                        const header = item.querySelector(".accordion-header");
                        const content =
                            item.querySelector(".accordion-content");
                        const icon = header.querySelector("span:last-child");
                        header.addEventListener("click", () => {
                            const isOpen =
                                content.style.maxHeight &&
                                content.style.maxHeight !== "0px";
                            if (isOpen) {
                                content.style.maxHeight = "0px";
                                icon.style.transform = "rotate(0deg)";
                            } else {
                                content.style.maxHeight =
                                    content.scrollHeight + "px";
                                icon.style.transform = "rotate(180deg)";
                            }
                        });
                    });
                }
            });
        </script>
        <script
            src="/assets/js/privacy-loader.js"
            data-cf-async="false"
            defer
            is:inline
        ></script>
    </Fragment>
