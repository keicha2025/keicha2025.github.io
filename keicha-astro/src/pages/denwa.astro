---
import MainLayout from "../layouts/MainLayout.astro";
import ContactSection from "../components/ContactSection.astro";
---

<MainLayout
    title="KEICHA 電話代撥服務 | 日本餐廳預約、活動代訂"
    description="KEICHA 提供專業的日本電話代撥服務，跨越語言障礙，為您代訂日本餐廳、預約活動、或聯繫處理日本事務。"
    keywords="KEICHA, 電話代撥, 電話代打, 日文電話, 餐廳預約, 日本預約, 日本代訂"
>
    <Fragment slot="head">
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0"
        />
        <style>
            #intro-loader {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: #ffffff;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 99999;
                transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
                    visibility 0.8s;
            }
            #intro-loader.hidden-fade {
                opacity: 0;
                visibility: hidden;
            }
            .handset-icon {
                color: #6ea44c;
                animation: handset-rock 1.2s infinite ease-in-out;
                margin-bottom: 2rem;
            }
            @keyframes handset-rock {
                0% {
                    transform: rotate(0deg);
                }
                25% {
                    transform: rotate(-12deg);
                }
                50% {
                    transform: rotate(0deg);
                }
                75% {
                    transform: rotate(12deg);
                }
                100% {
                    transform: rotate(0deg);
                }
            }
            .intro-text {
                text-align: center;
                color: #6ea44c;
                line-height: 1.8;
                letter-spacing: 0.15em;
            }
            .title-line {
                font-size: 1.25rem;
                font-weight: 700;
                display: block;
                margin-bottom: 0.5rem;
            }
            .subtitle-line {
                font-size: 0.95rem;
                font-weight: 400;
                opacity: 0.8;
                display: block;
            }
            #main-wrapper {
                opacity: 0;
                transition: opacity 1s ease;
            }
            #main-wrapper.visible {
                opacity: 1;
            }
            .lightbox {
                display: none;
                position: fixed;
                z-index: 1000;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                overflow: auto;
                background-color: rgba(0, 0, 0, 0.9);
                cursor: pointer;
                transition: opacity 0.3s ease;
            }
            .lightbox-content {
                margin: auto;
                display: block;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%) scale(0.8);
                max-width: 90%;
                max-height: 90vh;
                transition: transform 0.3s ease;
            }
            .lightbox.show {
                display: block;
                opacity: 1;
            }
            .lightbox.show .lightbox-content {
                transform: translate(-50%, -50%) scale(1);
            }
            .lightbox-close {
                position: absolute;
                top: 20px;
                right: 35px;
                color: #fff;
                font-size: 40px;
                font-weight: bold;
                transition: 0.3s;
                cursor: pointer;
                z-index: 1001;
            }
            .lightbox-close:hover,
            .lightbox-close:focus {
                color: #bbb;
            }
            .slider-slide img {
                cursor: pointer;
                transition: opacity 0.2s ease;
                max-height: 500px;
                margin: 0 auto;
                width: auto;
                object-fit: contain;
            }
            .slider-slide img:hover {
                opacity: 0.8;
            }
            .nav-link.active {
                background-color: #6ea44c;
                color: white;
                font-weight: 600;
            }
            .accordion-content {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.3s ease-out;
            }
            .slider-dot.active {
                background-color: #6ea44c;
                opacity: 1;
            }
            .privacy-content h3 {
                font-size: 1.125rem;
                font-weight: 600;
                color: #1e293b;
                margin-bottom: 0.5rem;
                margin-top: 1.5rem;
                padding-top: 1rem;
                border-top: 1px solid #e2e8f0;
            }
            .privacy-content section:first-child h3 {
                margin-top: 0;
                padding-top: 0;
                border-top: 0;
            }
            .privacy-content div,
            .privacy-content p {
                color: #334155;
                margin-bottom: 0.5rem;
                line-height: 1.6;
            }
            .privacy-content ul {
                list-style-type: disc;
                list-style-position: inside;
                padding-left: 1rem;
                color: #334155;
                margin-bottom: 0.5rem;
            }
            .loader {
                border-top-color: #6ea44c;
                animation: spin 1s linear infinite;
            }
            @keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }
            @media (max-width: 640px) {
                .btn-text {
                    display: none;
                }
            }
        </style>
    </Fragment>

    <!-- Intro Loader -->
    <div id="intro-loader">
        <div class="handset-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                <path
                    d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-2.2 2.2a15.053 15.053 0 01-6.59-6.59l2.2-2.21c.28-.26.36-.65.25-1.01A11.36 11.36 0 018.59 3.91c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1z"
                ></path>
            </svg>
        </div>
        <div class="intro-text">
            <span class="title-line brand-title-font">讓對話零距離</span>
            <span class="subtitle-line brand-title-font"
                >正在準備代撥服務指南</span
            >
        </div>
    </div>

    <div id="main-wrapper">
        <div
            class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 md:py-12"
        >
            <header class="text-center mb-8 md:mb-12">
                <h1
                    class="text-3xl md:text-4xl brand-title-font text-brandGreen"
                >
                    電話代撥服務
                </h1>
                <p class="mt-2 text-slate-600">
                    感謝您選擇 KEICHA，請在使用服務前詳閱以下條款並完成支付。
                </p>
            </header>

            <div class="flex flex-col md:flex-row gap-8">
                <!-- TOC Sidebar -->
                <aside class="md:w-1/4 lg:w-1/5 md:sticky md:top-28 self-start">
                    <nav
                        id="toc-nav"
                        class="bg-white rounded-[var(--r-md)] shadow-sm p-4"
                    >
                        <h3 class="font-semibold text-lg mb-3 text-slate-700">
                            頁面導覽
                        </h3>
                        <ul class="space-y-2">
                            <li>
                                <a
                                    href="#section-booking-method"
                                    class="nav-link block w-full text-left px-4 py-2 rounded-[var(--r-sm)] text-slate-600 hover:bg-slate-100 transition-colors duration-200"
                                    >預約與諮詢方式</a>
                            </li>
                            <li>
                                <a
                                    href="#section-payment"
                                    class="nav-link block w-full text-left px-4 py-2 rounded-[var(--r-sm)] text-slate-600 hover:bg-slate-100 transition-colors duration-200"
                                    >服務費用支付</a>
                            </li>
                            <li>
                                <a
                                    href="#section-terms"
                                    class="nav-link block w-full text-left px-4 py-2 rounded-[var(--r-sm)] text-slate-600 hover:bg-slate-100 transition-colors duration-200"
                                    >服務條款與介紹</a>
                            </li>
                            <li>
                                <a
                                    href="#section-privacy"
                                    class="nav-link block w-full text-left px-4 py-2 rounded-[var(--r-sm)] text-slate-600 hover:bg-slate-100 transition-colors duration-200"
                                    >隱私權條款</a>
                            </li>
                            <li>
                                <a
                                    href="#section-contact"
                                    class="nav-link block w-full text-left px-4 py-2 rounded-[var(--r-sm)] text-slate-600 hover:bg-slate-100 transition-colors duration-200"
                                    >聯絡方式</a>
                            </li>
                        </ul>
                    </nav>
                </aside>

                <main class="md:w-3/4 lg:w-4/5">
                    <div class="space-y-10">
                        <!-- Section: 預約與諮詢方式 -->
                        <section
                            id="section-booking-method"
                            class="bg-white p-6 md:p-8 rounded-[var(--r-lg)] shadow-sm border border-gray-100"
                        >
                            <h2 class="text-2xl font-bold text-brandGreen mb-6">
                                預約與諮詢方式
                            </h2>
                            <p class="text-slate-600 mb-8">
                                我們提供兩種預約管道，請依照您的需求選擇最適合的方式：
                            </p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div
                                    class="flex flex-col h-full bg-brandGreen/10 rounded-[var(--r-md)] p-6 border border-white hover:shadow-md transition duration-300"
                                >
                                    <div class="flex items-center mb-4">
                                        <span
                                            class="material-symbols-rounded text-3xl text-brandGreen mr-3 bg-white p-2 rounded-[var(--r-full)] shadow-sm"
                                            >edit_document</span
                                        >
                                        <h3
                                            class="text-xl font-bold text-gray-800"
                                        >
                                            線上填寫表單
                                        </h3>
                                    </div>
                                    <p
                                        class="text-gray-600 text-sm mb-6 flex-grow leading-relaxed"
                                    >
                                        系統將自動立案並推播給客服，流程最快速。
                                    </p>
                                    <a
                                        href="/denwa-form.html"
                                        class="block w-full text-center bg-brandGreen text-white py-3 rounded-[var(--r-md)] font-bold hover:bg-opacity-90 transition shadow-sm"
                                        >填表</a
                                    >
                                </div>
                                <div
                                    class="flex flex-col h-full bg-brandGreen/10 rounded-[var(--r-md)] p-6 border border-white hover:shadow-md transition duration-300"
                                >
                                    <div class="flex items-center mb-4">
                                        <span
                                            class="material-symbols-rounded text-3xl text-brandGreen mr-3 bg-white p-2 rounded-[var(--r-full)] shadow-sm"
                                            >chat</span
                                        >
                                        <h3
                                            class="text-xl font-bold text-gray-800"
                                        >
                                            直接私訊詢問
                                        </h3>
                                    </div>
                                    <p
                                        class="text-gray-600 text-sm mb-6 flex-grow leading-relaxed"
                                    >
                                        也歡迎直接透過 LINE 與我們聯絡<br />LINE
                                        ID：@366qwylw
                                    </p>
                                    <a
                                        href="https://lin.ee/F3JngaC"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="block w-full text-center bg-brandGreen text-white py-3 rounded-[var(--r-md)] font-bold hover:bg-opacity-90 transition shadow-sm"
                                        >私訊</a
                                    >
                                </div>
                            </div>
                        </section>

                        <!-- Section: 服務費用支付 -->
                        <section
                            id="section-payment"
                            class="scroll-mt-28 bg-white p-6 rounded-[var(--r-lg)] shadow-sm"
                        >
                            <h2 class="text-2xl font-bold text-brandGreen mb-4">
                                服務費用支付
                            </h2>
                            <p class="text-slate-600 mb-8 text-left">
                                請根據您的需求選擇支付方案，服務皆須先支付預付款。
                            </p>
                            <div
                                class="grid grid-cols-1 sm:grid-cols-3 gap-8 items-start justify-items-center text-center"
                            >
                                <div class="flex flex-col items-center w-full">
                                    <h3 class="font-semibold mb-3">
                                        預付款 (50元)
                                    </h3>
                                    <a
                                        href="https://pcpay.tw/EhQGv"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="w-full max-w-[180px] bg-brandGreen text-white py-2 rounded-[var(--r-md)] font-medium hover:bg-opacity-90 transition shadow"
                                        >支付</a
                                    >
                                </div>
                                <div class="flex flex-col items-center w-full">
                                    <h3 class="font-semibold mb-3">
                                        基本方案 (150元)
                                    </h3>
                                    <a
                                        href="https://pcpay.tw/yIurU"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="w-full max-w-[180px] bg-brandGreen text-white py-2 rounded-[var(--r-md)] font-medium hover:bg-opacity-90 transition shadow"
                                        >基本</a
                                    >
                                    <p class="text-xs text-slate-500 mt-2">
                                        (含50元預付款)
                                    </p>
                                </div>
                                <div class="flex flex-col items-center w-full">
                                    <h3 class="font-semibold mb-3">
                                        補款及尾款
                                    </h3>
                                    <a
                                        href="https://pcpay.tw/NF4vv"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="w-full max-w-[180px] bg-brandGreen text-white py-2 rounded-[var(--r-md)] font-medium hover:bg-opacity-90 transition shadow"
                                        >補款</a
                                    >
                                    <p class="text-xs text-slate-500 mt-2">
                                        進入後請自行填寫金額
                                    </p>
                                </div>
                            </div>
                            <div
                                class="mt-10 pt-8 border-t border-slate-200 text-center flex flex-col items-center"
                            >
                                <p class="text-sm text-slate-500 mb-3">
                                    如付款按鈕無法正常開啟，請複製以下付款連結至瀏覽器開啟，並自行填寫金額：
                                </p>
                                <input
                                    type="text"
                                    value="https://pcpay.tw/NF4vv"
                                    readonly
                                    onclick="this.select()"
                                    class="w-full max-w-md p-3 text-center bg-gray-50 border border-gray-300 rounded-[var(--r-md)] focus:outline-none focus:ring-2 focus:ring-brandGreen text-slate-700 mb-8"
                                    onfocus="this.select()"
                                />
                                <p class="text-slate-600 mb-3 font-medium">
                                    如有任何疑問，歡迎透過 LINE 聯絡我們<br
                                    />LINE ID：@366qwylw
                                </p>
                            </div>
                        </section>

                        <!-- Section: 服務條款與介紹 -->
                        <section
                            id="section-terms"
                            class="scroll-mt-28 bg-white p-6 rounded-[var(--r-lg)] shadow-sm"
                        >
                            <h2 class="text-2xl font-bold text-brandGreen mb-6">
                                服務條款與介紹
                            </h2>

                            <div class="service-subsection">
                                <h3
                                    class="text-xl font-bold text-slate-800 mb-4"
                                >
                                    服務內容
                                </h3>
                                <div class="space-y-4 text-slate-700">
                                    <div>
                                        <h4
                                            class="text-lg font-semibold mb-2 flex items-center"
                                        >
                                            <span
                                                class="material-symbols-rounded text-3xl text-brandGreen mr-3 select-none"
                                                >call</span
                                            >日本電話代撥服務
                                        </h4>
                                        <p class="mb-2">
                                            協助您處理以下單次可完成的日文溝通需求：
                                        </p>
                                        <ul
                                            class="list-disc list-inside space-y-1 pl-4"
                                        >
                                            <li>餐廳訂位、預訂變更或取消。</li>
                                            <li>
                                                向商家（飯店、餐廳等）進行各類詢問。
                                            </li>
                                            <li>
                                                其他需要日文溝通的代辦事項。
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="border-t pt-4">
                                        <h4
                                            class="text-lg font-semibold mb-2 flex items-center"
                                        >
                                            <span
                                                class="material-symbols-rounded text-3xl text-brandGreen mr-3 select-none"
                                                >language</span
                                            >網路代訂服務
                                        </h4>
                                        <p>
                                            協助您代為操作日本網站進行餐廳、飯店等預訂。
                                        </p>
                                        <ul
                                            class="list-disc list-inside space-y-1 pl-4"
                                        >
                                            <li>
                                                <strong>服務限制：</strong
                                                >僅限無須事先付款、或由本店代為付款的內容。所有後續的兌換、現場付款、領取等操作、均須由客戶自行處理。
                                            </li>
                                            <li>
                                                <strong>服務包含：</strong
                                                >訂單完成後、提供簡要的中文翻譯說明。
                                            </li>
                                        </ul>
                                    </div>
                                    <div
                                        class="bg-red-50 border-l-4 border-red-400 p-4 rounded-r-lg mt-4"
                                    >
                                        <h4
                                            class="text-lg font-semibold text-red-800 mb-2"
                                        >
                                            無法受理之服務
                                        </h4>
                                        <p class="text-red-700">
                                            請於下單前確認，若下單後發現屬於此類，將依退款規則處理：
                                        </p>
                                        <ul
                                            class="list-disc list-inside space-y-1 pl-4 text-red-700 mt-2"
                                        >
                                            <li>撥打非商家之私人電話。</li>
                                            <li>
                                                依法規或商家規定，需本人親自辦理之業務。
                                            </li>
                                            <li>無法接收國際來電之商家。</li>
                                            <li>
                                                各類網路平台、App
                                                註冊所需之電話號碼認證服務。
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- 服務實績 -->
                            <div
                                class="service-subsection mt-8 pt-6 border-t border-slate-200"
                            >
                                <h3
                                    class="text-xl font-bold text-slate-800 mb-4"
                                >
                                    服務實績
                                </h3>
                                <p class="text-slate-600 mb-4">
                                    我們已成功協助眾多客戶處理日本大小事宜：
                                </p>
                                <div
                                    class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-3 text-slate-700"
                                >
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >敘敘苑 餐廳預約
                                    </div>
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >炉ばた焼ウタリ 餐廳預約
                                    </div>
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >酒処ふじりん 餐廳預約
                                    </div>
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >琉球の牛(燒肉店) 餐廳預約
                                    </div>
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >よろにく (燒肉店) 預約取消
                                    </div>
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >涸沢ヒュッテ (上高地山小屋) 住宿預約
                                    </div>
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >Yama登山用品 租借預約
                                    </div>
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >燒肉五苑 更改預約人數
                                    </div>
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >TOYOTA租車 指定車款預約
                                    </div>
                                    <div class="flex items-center">
                                        <span
                                            class="text-brandGreen font-bold mr-2"
                                            >✓</span
                                        >銀座三越百貨 遺失物詢問
                                    </div>
                                </div>
                            </div>

                            <!-- Slider -->
                            <div
                                id="slider-container"
                                class="relative w-full max-w-2xl mx-auto rounded-[var(--r-lg)] overflow-hidden shadow-lg bg-brandGreen mt-8 aspect-[16/9] group"
                            >
                                <div
                                    id="slider-wrapper"
                                    class="flex h-full transition-transform duration-500 ease-in-out"
                                >
                                    <div
                                        class="slider-slide w-full flex-shrink-0 flex items-center justify-center h-full"
                                    >
                                        <img
                                            src="/images/keicha_電話代撥_服務案例1.png"
                                            alt="服務案例1"
                                            class="w-full h-full object-contain lightbox-trigger cursor-pointer hover:opacity-95 transition-opacity"
                                        />
                                    </div>
                                    <div
                                        class="slider-slide w-full flex-shrink-0 flex items-center justify-center h-full"
                                    >
                                        <img
                                            src="/images/keicha_電話代撥_服務案例2.png"
                                            alt="服務案例2"
                                            class="w-full h-full object-contain lightbox-trigger cursor-pointer hover:opacity-95 transition-opacity"
                                        />
                                    </div>
                                </div>
                                <button
                                    id="slider-prev"
                                    class="absolute top-1/2 left-2 transform -translate-y-1/2 bg-white bg-opacity-50 hover:bg-opacity-75 rounded-[var(--r-full)] p-2 focus:outline-none z-10"
                                >
                                    <svg
                                        class="w-6 h-6 text-gray-800"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M15 19l-7-7 7-7"></path>
                                    </svg>
